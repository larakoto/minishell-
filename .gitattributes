# Auto normalize line endings for all text files and normalize them to LF
* text=auto eol=lf

# Source files
*.c text eol=lf
*.h text eol=lf
*.mk text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration files
.gitignore text eol=lf
.gitattributes text eol=lf
Makefile text eol=lf
*.sh text eol=lf

# Binary files
*.o binary
*.a binary
*.so binary
*.dylib binary
